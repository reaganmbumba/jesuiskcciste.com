# JE SUIS KCCiste — variables d'environnement (copier en .env.local)
# Uniquement des valeurs PUBLIQUES côté navigateur.
# NE JAMAIS mettre la clé "service_role" de Supabase ici ni dans le frontend.

# URL du projet Supabase (Settings > API)
VITE_SUPABASE_URL=
# Clé publique "anon" (protégée par les politiques RLS)
VITE_SUPABASE_ANON_KEY=

# URL publique du site (redirections d'e-mails d'authentification)
VITE_SITE_URL=http://localhost:5173
