{
  "name": "kcc-studio",
  "productName": "Je suis KCCiste Studio",
  "version": "1.0.0",
  "description": "Régie de direct Je suis KCCiste : téléphones caméras, habillage et diffusion YouTube",
  "author": "Je suis KCCiste",
  "license": "UNLICENSED",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/essais.js",
    "dist": "electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "5.2.0",
    "qrcode": "1.5.4",
    "ws": "8.18.0"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.jesuiskcciste.studio",
    "productName": "Je suis KCCiste Studio",
    "artifactName": "KCC-Studio-Setup-${version}.${ext}",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "server.js", "output.js", "renderer/**", "build/icon.png", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**"],
    "extraResources": [
      { "from": "../camera", "to": "camera" },
      { "from": "camera-apk", "to": "camera-apk" }
    ],
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Je suis KCCiste Studio",
      "language": "1036"
    }
  }
}
